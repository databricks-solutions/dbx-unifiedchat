%%{init: {"theme":"base","themeVariables":{"background":"#ffffff"}}}%%
graph LR
    %% Simplified summarize flow
    Upstream[Upstream workflow<br/>synthesis / execution] --> SumNode[summarize_node]
    SumNode --> Extract[Minimal context extraction<br/>recent messages + result artifacts]
    Extract --> Agent[ResultSummarizeAgent]
    Agent --> Summary[Streaming markdown summary]

    %% Parallel enrichments
    SumNode --> Charts[Visualization workspace generation]
    SumNode --> SQL[SQL / explanation sections]
    SumNode --> Code[Code enrichment]

    Charts --> Summary
    SQL --> Summary
    Code --> Summary

    Summary --> Frontend[Frontend stream renderer]
    Frontend --> User[User]

    %% Styling
    classDef agentClass fill:#4A90E2,stroke:#2E5C8A,stroke-width:2px,color:#fff
    classDef dataClass fill:#50C878,stroke:#2E7D4E,stroke-width:2px,color:#fff
    classDef processClass fill:#F5A623,stroke:#C17D11,stroke-width:2px,color:#000
    classDef insightClass fill:#1ABC9C,stroke:#16A085,stroke-width:2px,color:#fff

    class SumNode,Agent,Frontend agentClass
    class Summary,User insightClass
    class Upstream,Extract,Charts,Tables,SQL,Code processClass
