graph TD
    Start([START]) --> Load[Load space context]
    Load --> Classify[Classify query type]
    Load --> Clarity[Check clarity and context summary]
    Classify --> Merge[Merge classification]
    Clarity --> Merge
    Merge --> Route{Route}
    Route -->|irrelevant| Irrelevant[Handle irrelevant query]
    Route -->|meta question| Meta[Generate meta answer]
    Route -->|unclear| Clarify[Clarify<br/>interrupt for user input]
    Route -->|clear| Clear[Handle clear<br/>continue to planning]
    Clarify --> Confirm{Response answers clarification?}
    Confirm -->|yes| Clear
    Confirm -->|new question| Load
    Irrelevant --> End([END])
    Meta --> End
    Clear --> End

    classDef agentClass fill:#4A90E2,stroke:#2E5C8A,stroke-width:2px,color:#fff
    classDef processClass fill:#F5A623,stroke:#C17D11,stroke-width:2px,color:#000
    classDef decisionClass fill:#8E44AD,stroke:#6C3483,stroke-width:2px,color:#fff
    classDef interruptClass fill:#E94B3C,stroke:#A33428,stroke-width:2px,color:#fff
    classDef boundaryClass fill:#34495E,stroke:#1F2D3A,stroke-width:2px,color:#fff

    class Start,End boundaryClass
    class Load,Classify,Clarity,Merge,Clear processClass
    class Route,Confirm decisionClass
    class Irrelevant,Meta agentClass
    class Clarify interruptClass
