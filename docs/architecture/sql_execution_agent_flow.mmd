graph TD
    SQLIn[SQL queries from synthesis] --> ExecNode[sql_execution_node]
    ExecNode --> Empty{Any SQL queries?}
    Empty -->|no, preserved results| Preserved[Return preserved results<br/>summarize]
    Empty -->|no results| NoSql[execution_error<br/>summarize]
    Empty -->|yes| Config[Load SQL warehouse config]
    Config --> Agent[SQL Execution Agent]
    Agent --> Mode{execution_mode}

    Mode -->|parallel| Parallel[Execute all queries in parallel]
    Mode -->|sequential| Sequential[Execute one query<br/>for current step]

    Parallel --> Normalize[Attach metadata<br/>status, labels, row grain hints]
    Sequential --> Normalize
    Normalize --> Outcome{Execution outcome}

    Outcome -->|all success| Summary[Set execution_results<br/>summarize]
    Outcome -->|partial failure + retry budget| Retry[Build retry feedback<br/>preserve successes]
    Outcome -->|sequential success + more steps| NextStep[Build sequential feedback<br/>loop to synthesis]
    Outcome -->|failure exhausted or complete| Summary

    Retry --> Route[Route back to synthesis<br/>table or Genie route]
    NextStep --> Route
    Route --> Synth[SQL synthesis agent]

    classDef agentClass fill:#4A90E2,stroke:#2E5C8A,stroke-width:2px,color:#fff
    classDef dataClass fill:#50C878,stroke:#2E7D4E,stroke-width:2px,color:#fff
    classDef processClass fill:#F5A623,stroke:#C17D11,stroke-width:2px,color:#000
    classDef decisionClass fill:#8E44AD,stroke:#6C3483,stroke-width:2px,color:#fff

    class ExecNode,Agent agentClass
    class SQLIn,Preserved,NoSql,Summary,Synth dataClass
    class Config,Parallel,Sequential,Normalize,Retry,NextStep,Route processClass
    class Empty,Mode,Outcome decisionClass
