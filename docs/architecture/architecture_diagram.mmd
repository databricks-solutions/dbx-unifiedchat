graph TB
    %% Current Runtime Workflow
    User[User Query] --> App[ResponsesAgent / app wrapper]
    App --> Workflow[LangGraph supervisor workflow]
    Lakebase[(Lakebase checkpoints)] -.checkpoints.-> Workflow

    Workflow --> Clarification[Unified Intent Context Clarification<br/>ClarificationAgent subgraph]
    Clarification --> IntentRoute{Intent route}
    IntentRoute -->|irrelevant query| End([END])
    IntentRoute -->|meta question| End
    IntentRoute -->|data question| PlanningAgent[Planning Agent]

    PlanningAgent --> VSSearch[Vector Search<br/>relevant Genie spaces]
    VSIndex[(Vector Search Index<br/>space_summary chunks)] --> VSSearch
    VSSearch --> Plan[Execution plan<br/>sub_questions, spaces, join_strategy]
    Plan --> Route{Resolved synthesis route}

    Route -->|table_route| SQLTableAgent[SQL Synthesis Table Agent<br/>UC function tools]
    Route -->|genie_route| SQLGenieAgent[SQL Synthesis Genie Agent<br/>Genie space tools]
    SQLTableAgent --> SQLRoute{SQL generated?}
    SQLGenieAgent --> SQLRoute
    SQLRoute -->|no SQL or error| SummarizeAgent[Result Summarize Agent]
    SQLRoute -->|SQL queries| SQLExec[SQL Execution Agent]

    SQLExec --> ExecRoute{Execution route}
    ExecRoute -->|parallel success / partial / exhausted retry| SummarizeAgent
    ExecRoute -->|retry failed SQL| SQLTableAgent
    ExecRoute -->|retry failed SQL| SQLGenieAgent
    ExecRoute -->|sequential next step| SQLTableAgent
    ExecRoute -->|sequential next step| SQLGenieAgent

    SummarizeAgent --> FinalAnswer[Final Answer<br/>markdown + visualization workspace]
    FinalAnswer --> User

    %% Supporting Data Pipeline
    subgraph ETLPipeline["Supporting metadata pipeline"]
        direction TB
        GSE[Export Genie spaces] --> TMU[Enrich table metadata]
        TMU --> Chunks[(enriched_genie_docs_chunks)]
        Chunks --> VSBuild[Build Delta Sync Vector Search index]
    end
    VSBuild --> VSIndex
    Chunks -.UC function metadata.-> SQLTableAgent

    DeltaTables[(Delta Tables)] -.queried by.-> SQLExec
    GenieSpaces[(Genie Spaces)] -.queried by.-> SQLGenieAgent

    MLflow[MLflow tracing] -.spans.-> Workflow
    MLflow -.spans.-> Clarification
    MLflow -.spans.-> PlanningAgent
    MLflow -.spans.-> SQLTableAgent
    MLflow -.spans.-> SQLGenieAgent
    MLflow -.spans.-> SQLExec
    MLflow -.spans.-> SummarizeAgent

    %% Styling
    classDef agentClass fill:#4A90E2,stroke:#2E5C8A,stroke-width:2px,color:#fff
    classDef dataClass fill:#50C878,stroke:#2E7D4E,stroke-width:2px,color:#fff
    classDef processClass fill:#F5A623,stroke:#C17D11,stroke-width:2px,color:#000
    classDef decisionClass fill:#8E44AD,stroke:#6C3483,stroke-width:2px,color:#fff
    classDef pipelineClass fill:#9B59B6,stroke:#6C3483,stroke-width:2px,color:#fff
    classDef memoryClass fill:#16A085,stroke:#117A65,stroke-width:2px,color:#fff
    classDef boundaryClass fill:#34495E,stroke:#1F2D3A,stroke-width:2px,color:#fff

    class App,Workflow,Clarification,PlanningAgent,SQLTableAgent,SQLGenieAgent,SQLExec,SummarizeAgent agentClass
    class VSIndex,Chunks,DeltaTables,GenieSpaces,FinalAnswer dataClass
    class User,VSSearch,Plan,MLflow processClass
    class IntentRoute,Route,SQLRoute,ExecRoute decisionClass
    class GSE,TMU,VSBuild pipelineClass
    class Lakebase memoryClass
    class End boundaryClass

