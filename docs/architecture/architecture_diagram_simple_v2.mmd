graph TD
    %% ============================================================
    %% Current Hybrid Super Agent Workflow
    %% ============================================================

    User[User query]
    Workflow[LangGraph supervisor workflow<br/>create_super_agent_hybrid]
    Clarify[Unified intent, context, clarification<br/>ClarificationAgent subgraph]
    UnifiedRoute{Terminal intent?}

    Planning[Planning Agent<br/>vector search + execution plan]
    PlanRoute{next_agent from plan}

    SynthTable[SQL Synthesis Agent<br/>table route with UC functions]
    SynthGenie[SQL Synthesis Agent<br/>Genie route with Genie tools]
    SynthesisRoute{SQL generated?}

    Exec[SQL Execution Agent<br/>parallel or sequential execution]
    ExecRoute{execution outcome}

    Summarize[Result Summarize Agent<br/>summary + visualization workspace]
    End([END])
    Answer[Final response]

    User --> Workflow --> Clarify --> UnifiedRoute
    UnifiedRoute -->|irrelevant or meta question| End
    UnifiedRoute -->|clear data question| Planning

    Planning --> PlanRoute
    PlanRoute -->|table_route| SynthTable
    PlanRoute -->|genie_route| SynthGenie
    PlanRoute -->|no SQL path| Summarize

    SynthTable --> SynthesisRoute
    SynthGenie --> SynthesisRoute
    SynthesisRoute -->|has SQL| Exec
    SynthesisRoute -->|no SQL or error| Summarize

    Exec --> ExecRoute
    ExecRoute -->|success, partial, or exhausted retries| Summarize
    ExecRoute -->|retry failed SQL| SynthTable
    ExecRoute -->|retry failed SQL| SynthGenie
    ExecRoute -->|sequential next step| SynthTable
    ExecRoute -->|sequential next step| SynthGenie

    Summarize --> Answer --> End

    %% ============================================================
    %% Styling
    %% ============================================================
    classDef userClass fill:#E94B3C,stroke:#A33428,stroke-width:2px,color:#fff,rx:10,ry:10
    classDef agentClass fill:#4A90E2,stroke:#2E5C8A,stroke-width:2px,color:#fff,rx:10,ry:10
    classDef routeClass fill:#F5A623,stroke:#C17D11,stroke-width:2px,color:#000,rx:10,ry:10
    classDef decisionClass fill:#8E44AD,stroke:#6C3483,stroke-width:2px,color:#fff,rx:10,ry:10
    classDef answerClass fill:#50C878,stroke:#2E7D4E,stroke-width:2px,color:#fff,rx:10,ry:10
    classDef boundaryClass fill:#34495E,stroke:#1F2D3A,stroke-width:2px,color:#fff,rx:10,ry:10

    class User userClass
    class Workflow,Clarify,Planning,Summarize agentClass
    class SynthTable,SynthGenie,Exec routeClass
    class UnifiedRoute,PlanRoute,SynthesisRoute,ExecRoute decisionClass
    class Answer answerClass
    class End boundaryClass