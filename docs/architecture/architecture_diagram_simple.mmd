graph LR
    %% Main Flow - Simplified Current Runtime
    User[User] --> Workflow[LangGraph supervisor workflow]
    Workflow --> Clarify[Unified clarification subgraph]
    Clarify --> Intent{Terminal intent?}
    Intent -->|meta or irrelevant| End([END])
    Intent -->|data question| Planning[Planning Agent]
    Planning --> VSIndex[(Vector Search Index)]
    VSIndex --> Route{Synthesis route?}
    Route -->|table_route| SQLTable[SQL Synthesis Table Agent]
    Route -->|genie_route| SQLGenie[SQL Synthesis Genie Agent]
    SQLTable --> SQLExec[SQL Execution Agent]
    SQLGenie --> SQLExec
    SQLExec -->|success or exhausted retry| Summarize[Result Summarize Agent]
    SQLExec -->|retry or sequential next| SQLTable
    SQLExec -->|retry or sequential next| SQLGenie
    SQLTable -->|no SQL or error| Summarize
    SQLGenie -->|no SQL or error| Summarize
    Summarize --> User

    %% Supporting data and operations
    GenieExport[Export Genie spaces] --> TableEnrich[Enrich table metadata]
    TableEnrich --> EnrichedDocs[(Enriched docs Delta table)]
    EnrichedDocs --> VSBuild[Build VS index]
    VSBuild --> VSIndex
    DeltaTables[(Delta tables)] -.-> SQLExec
    Lakebase[(Lakebase checkpoints)] -.-> Workflow
    MLflow[MLflow tracing] -.traces.-> Workflow

    %% Styling
    classDef agentClass fill:#4A90E2,stroke:#2E5C8A,stroke-width:2px,color:#fff
    classDef dataClass fill:#50C878,stroke:#2E7D4E,stroke-width:2px,color:#fff
    classDef processClass fill:#F5A623,stroke:#C17D11,stroke-width:2px,color:#000
    classDef decisionClass fill:#8E44AD,stroke:#6C3483,stroke-width:2px,color:#fff
    classDef etlClass fill:#9B59B6,stroke:#6C3483,stroke-width:2px,color:#fff
    classDef boundaryClass fill:#34495E,stroke:#1F2D3A,stroke-width:2px,color:#fff

    class Workflow,Clarify,Planning,SQLTable,SQLGenie,SQLExec,Summarize agentClass
    class VSIndex,DeltaTables,EnrichedDocs,Lakebase dataClass
    class User,MLflow processClass
    class Intent,Route decisionClass
    class GenieExport,TableEnrich,VSBuild etlClass
    class End boundaryClass

