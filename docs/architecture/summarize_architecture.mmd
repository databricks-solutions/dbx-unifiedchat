graph TD
    %% ============================================================
    %% Result Summarize Agent Architecture
    %% ============================================================

    Start[Upstream terminal path<br/>synthesis or execution] --> SumNode[summarize_node<br/>final LangGraph node]

    SumNode --> Artifacts[Normalize result artifacts<br/>_build_artifact_entries]
    SumNode --> Context[Extract summary context<br/>trim messages to recent turns]
    SumNode --> Writer[Stream writer events]
    SumNode --> Cache[Get cached ResultSummarizeAgent]

    Cache --> SummaryLLM[Summary LLM]
    Context --> SummaryPrompt[Build summary prompt]
    SummaryLLM --> StreamSummary[Stream markdown summary]
    Writer -. text_delta .-> StreamSummary

    Artifacts --> Fanout{Successful result artifacts?}
    Fanout -->|yes| ChartBG[Background chart generation]
    Fanout -->|yes| EnrichBG[Background code enrichment]
    Fanout -->|no| Compose[Compose final response]

    ChartBG --> ChartGen[ChartGenerator.generate_chart]
    ChartGen --> VizPayload[Visualization workspace payload<br/>chart + preview table + downloads]
    ChartGen --> ChartFallback[Fallback row-count chart<br/>when chart generation unavailable]

    EnrichBG --> CodeLookup[Detect and enrich code columns]
    CodeLookup --> CodeRefs[Code reference sections]

    StreamSummary --> Compose
    VizPayload --> Compose
    ChartFallback --> Compose
    CodeRefs --> Compose
    Artifacts --> SqlBlocks[SQL text + explanations]
    SqlBlocks --> Compose

    Compose --> FinalSummary[final_summary]
    Compose --> Message[AIMessage summary content]
    FinalSummary --> Frontend[Frontend stream renderer]
    Message --> End([END])
    Frontend --> User[User]

    classDef agentClass fill:#4A90E2,stroke:#2E5C8A,stroke-width:2px,color:#fff
    classDef dataClass fill:#50C878,stroke:#2E7D4E,stroke-width:2px,color:#fff
    classDef processClass fill:#F5A623,stroke:#C17D11,stroke-width:2px,color:#000
    classDef decisionClass fill:#8E44AD,stroke:#6C3483,stroke-width:2px,color:#fff
    classDef boundaryClass fill:#34495E,stroke:#1F2D3A,stroke-width:2px,color:#fff

    class SumNode,Frontend agentClass
    class Start,SummaryLLM,FinalSummary,Message,User dataClass
    class Artifacts,Context,Writer,Cache,SummaryPrompt,StreamSummary,ChartBG,EnrichBG,ChartGen,VizPayload,ChartFallback,CodeLookup,CodeRefs,SqlBlocks,Compose processClass
    class Fanout decisionClass
    class End boundaryClass
